# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=2283
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:2283     # what phones and browsers connect to
SSL_PROXY=0
IMMICH_VERSION=v3.3.1                # the Immich release this package pins; moved only by a package update, after a database backup
IMMICH_IMAGE=ghcr.io/immich-app/immich-server:v3.3.1
ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:v3.3.1
DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:…
REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:…
DB_PASSWORD=…                        # made at install (letters and digits only, as Immich asks)
DB_STORAGE_TYPE=HDD                  # SSD if the volume is on SSDs
UPLOAD_SRC=./photos                  # uploads, thumbnails, transcoded videos: the photos folder of this shared folder
ML_ENABLED=true                      # machine learning: smart search, faces, duplicates
COMPOSE_PROFILES=ml                  # empty when machine learning is off (its container isn't run)
ADMIN_EMAIL=you@example.com          # your administrator account (its password is never stored; it's shown once)
ADMIN_NAME="Your Name"
IMMICH_API_KEY=…                     # the package's own API key, made with your account at the first start (root-only file)
LIB1_DIR="/volume1/photo"            # up to five photo folders, read-only, as Immich external libraries
LIB1_SRC="/volume1/photo"            # what is mounted: LIB1_DIR, or ./no-library while that folder is missing
LIB1_ID=…                            # the Immich library that reads it
